#!/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/@@PACKAGE_NAME@@-flags.conf ]]; then
    TERMLOC_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/@@PACKAGE_NAME@@-flags.conf)"
fi

# Launch
exec /opt/termloc/@@PACKAGE_NAME@@/@@BINARY_NAME@@ $TERMLOC_USER_FLAGS "$@"
