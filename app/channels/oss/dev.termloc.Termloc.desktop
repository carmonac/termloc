[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Termloc
GenericName=TerminalEmulator

Exec=termloc %U
StartupWMClass=dev.termloc.Termloc

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.termloc.Termloc

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for termloc:// URLs.
MimeType=x-scheme-handler/termloc;
